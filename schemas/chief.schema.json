{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "description": "Chief of Crypto operator brief. Research states stay proposed until Risk.",
  "required": [
    "summary",
    "cutoff",
    "thesis",
    "unknowns"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "disconfirmingEvidence": {
      "type": "string"
    },
    "invalidation": {
      "type": "string"
    },
    "liquidity": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "kind"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "calculation",
              "assumption",
              "inference",
              "forecast",
              "judgment"
            ]
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "horizons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "incomplete"
        ],
        "properties": {
          "id": {
            "enum": [
              "12h",
              "24h",
              "3d",
              "7d"
            ]
          },
          "bearUpper": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000.0
          },
          "bullLower": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000.0
          },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 3,
            "maxItems": 3
          },
          "drivers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "invalidations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "gapReason": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "incomplete": {
                "const": true
              },
              "gapReason": {
                "type": "string",
                "minLength": 1
              },
              "bearUpper": false,
              "bullLower": false,
              "probabilities": false,
              "drivers": false,
              "triggers": false,
              "invalidations": false,
              "confidence": false
            },
            "required": [
              "gapReason"
            ]
          },
          {
            "properties": {
              "incomplete": {
                "const": false
              },
              "gapReason": {
                "const": ""
              }
            },
            "required": [
              "bearUpper",
              "bullLower",
              "probabilities",
              "drivers",
              "triggers",
              "invalidations",
              "confidence"
            ]
          }
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "type",
          "capturedAt",
          "claim",
          "excerpt"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "claim": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}

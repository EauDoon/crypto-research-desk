{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "description": "Market regime evidence packet.",
  "required": [
    "summary",
    "classification",
    "cutoff",
    "facts",
    "unknowns",
    "sources"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "expansion",
        "transition",
        "distribution",
        "contraction",
        "unknown"
      ]
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "kind"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "calculation",
              "assumption",
              "inference",
              "forecast",
              "judgment"
            ]
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "probability",
          "driver"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "driver": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "horizons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "incomplete"
        ],
        "properties": {
          "id": {
            "enum": [
              "12h",
              "24h",
              "3d",
              "7d"
            ]
          },
          "bearUpper": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000.0
          },
          "bullLower": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000.0
          },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 3,
            "maxItems": 3
          },
          "drivers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "invalidations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "gapReason": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "incomplete": {
                "const": true
              },
              "gapReason": {
                "type": "string",
                "minLength": 1
              },
              "bearUpper": false,
              "bullLower": false,
              "probabilities": false,
              "drivers": false,
              "triggers": false,
              "invalidations": false,
              "confidence": false
            },
            "required": [
              "gapReason"
            ]
          },
          {
            "properties": {
              "incomplete": {
                "const": false
              },
              "gapReason": {
                "const": ""
              }
            },
            "required": [
              "bearUpper",
              "bullLower",
              "probabilities",
              "drivers",
              "triggers",
              "invalidations",
              "confidence"
            ]
          }
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "type",
          "capturedAt",
          "claim",
          "excerpt"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "claim": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "description",
        "sourceWindow",
        "observationFrequency",
        "transformations",
        "regimeAdjustment",
        "eventAssumptions",
        "limitations",
        "sampleSize"
      ],
      "properties": {
        "basis": {
          "enum": [
            "judgmental",
            "empirical",
            "model-derived"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceWindow": {
          "type": "string",
          "minLength": 1
        },
        "observationFrequency": {
          "type": "string",
          "minLength": 1
        },
        "transformations": {
          "type": "string",
          "minLength": 1
        },
        "regimeAdjustment": {
          "type": "string",
          "minLength": 1
        },
        "eventAssumptions": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "sampleSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}

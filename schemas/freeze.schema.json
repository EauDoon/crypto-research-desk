{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "canonicalUrl",
    "capturedAt",
    "sha256",
    "bytes"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contentType": {
      "type": "string"
    },
    "etag": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
